

<!-- ═══════════════════════════════════════════════════════════════════
     res/values/styles.xml  (add these to your existing styles)
═══════════════════════════════════════════════════════════════════ -->
<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Peerly" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/space_bg</item>
        <item name="android:statusBarColor">@color/space_bg</item>
        <item name="android:navigationBarColor">@color/space_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="PeerlyEditText">
        <item name="android:background">@drawable/bg_input_field</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="PeerlyButton">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:padding">14dp</item>
    </style>
</resources>

