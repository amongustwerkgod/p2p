<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/space_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="64dp"
        android:text="PEERLY"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:letterSpacing="0.35"
        android:fontFamily="monospace"
        android:alpha="0.9" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="104dp"
        android:text="peer-to-peer messenger"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:letterSpacing="0.15"
        android:fontFamily="monospace" />

    <!-- Earth rises from below in code -->
    <com.example.Peerly.EarthView
        android:id="@+id/earthView"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="center"
        android:layout_marginBottom="80dp" />

    <!-- Card slides up from bottom -->
    <LinearLayout
        android:id="@+id/loginCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_card"
        android:orientation="vertical"
        android:padding="28dp"
        android:paddingBottom="48dp"
        android:visibility="invisible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="choose a callsign"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:letterSpacing="0.15"
            android:fontFamily="monospace"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/usernameInput"
            style="@style/PeerlyEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="username"
            android:imeOptions="actionDone"
            android:inputType="textNoSuggestions"
            android:maxLength="20"
            android:singleLine="true" />

        <Button
            android:id="@+id/joinButton"
            style="@style/PeerlyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="JOIN THE NETWORK" />

        <TextView
            android:id="@+id/onlineCountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:textColor="@color/online_green"
            android:textSize="11sp"
            android:fontFamily="monospace"
            tools:text="● 7 online now" />
    </LinearLayout>

</FrameLayout>
