<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/space_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="84dp"
        android:text="PEERLY"
        android:textColor="@color/text_primary"
        android:textSize="32sp"
        android:letterSpacing="0.4"
        android:fontFamily="sans-serif-light"
        android:alpha="0.9" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="130dp"
        android:text="SECURE P2P MESH NETWORK"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:letterSpacing="0.25"
        android:fontFamily="sans-serif-medium" />

    <com.example.Peerly.EarthView
        android:id="@+id/earthView"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_gravity="center"
        android:layout_marginTop="20dp" />

    <LinearLayout
        android:id="@+id/loginCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_card"
        android:orientation="vertical"
        android:padding="32dp"
        android:paddingBottom="64dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IDENTIFY YOURSELF"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:letterSpacing="0.2"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/usernameInput"
            style="@style/PeerlyEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="CALLSIGN"
            android:imeOptions="actionDone"
            android:inputType="textNoSuggestions"
            android:maxLength="20"
            android:singleLine="true" />

        <Button
            android:id="@+id/joinButton"
            style="@style/PeerlyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="ENTER NETWORK" />

    </LinearLayout>

</FrameLayout>
