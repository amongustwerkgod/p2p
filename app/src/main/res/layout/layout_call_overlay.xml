<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/callOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/space_bg"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="100dp">

        <TextView
            android:id="@+id/callPeerAvatar"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/bg_peer_avatar"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="48sp"
            android:fontFamily="monospace"
            android:text="A" />

        <TextView
            android:id="@+id/callPeerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:fontFamily="monospace"
            android:text="Peer Name" />

        <TextView
            android:id="@+id/callStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/accent"
            android:textSize="16sp"
            android:fontFamily="monospace"
            android:text="Calling..." />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="80dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/rejectCallBtn"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginEnd="40dp"
            android:background="@drawable/bg_send_button"
            android:backgroundTint="#FF4444"
            android:src="@drawable/ic_call"
            android:rotation="135"
            app:tint="@color/white"
            android:padding="20dp"
            android:scaleType="fitCenter" />

        <ImageButton
            android:id="@+id/acceptCallBtn"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_send_button"
            android:backgroundTint="#44FF44"
            android:src="@drawable/ic_call"
            app:tint="@color/white"
            android:padding="20dp"
            android:scaleType="fitCenter"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
