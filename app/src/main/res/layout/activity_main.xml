<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/space_bg">

    <!-- The custom background with stars and the Earth -->
    <com.example.Peerly.HubView
        android:id="@+id/hubView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Login UI Overlay -->
    <LinearLayout
        android:id="@+id/loginContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:visibility="visible">

        <TextView
            android:id="@+id/loginTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="84dp"
            android:text="PEERLY"
            android:textColor="@color/text_primary"
            android:textSize="32sp"
            android:letterSpacing="0.4"
            android:fontFamily="sans-serif-light"
            android:alpha="0.9" />

        <TextView
            android:id="@+id/loginSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="SECURE P2P MESH NETWORK"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:letterSpacing="0.25"
            android:fontFamily="sans-serif-medium" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/loginCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bottom_card"
            android:orientation="vertical"
            android:padding="32dp"
            android:paddingBottom="64dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IDENTIFY YOURSELF"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:letterSpacing="0.2"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/usernameInput"
                style="@style/PeerlyEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="CALLSIGN"
                android:imeOptions="actionDone"
                android:inputType="textNoSuggestions"
                android:maxLength="20"
                android:singleLine="true" />

            <Button
                android:id="@+id/joinButton"
                style="@style/PeerlyButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="ENTER NETWORK" />
        </LinearLayout>
    </LinearLayout>

    <!-- World Chat UI Overlay -->
    <LinearLayout
        android:id="@+id/chatContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:alpha="0">

        <!-- Custom Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/input_bar_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Back"
                app:tint="@color/text_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:text="world chat" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/online_green"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif"
                    android:text="global broadcast" />
            </LinearLayout>

            <TextView
                android:id="@+id/onlineCountLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_room_code"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="@color/accent"
                android:textSize="10sp"
                android:fontFamily="monospace"
                tools:text="7 online" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/input_bar_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <EditText
                android:id="@+id/messageInput"
                style="@style/PeerlyEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="broadcast to world…"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:minLines="1" />

            <ImageButton
                android:id="@+id/sendButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_send_button"
                android:src="@drawable/ic_send"
                android:contentDescription="Send"
                android:tint="@color/white"
                android:padding="10dp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
